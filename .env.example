# Server-side only. Never use a VITE_ prefix for secrets.
META_APP_ID=
META_CONFIG_ID=
META_APP_SECRET=
# Choose a supported version after checking the Meta app and official documentation.
META_GRAPH_API_VERSION=
# HTTPS canonical origin, without trailing slash.
APP_ORIGIN=
# PostgreSQL connection URL with TLS certificate verification (verify-full).
DATABASE_URL=
META_WEBHOOK_VERIFY_TOKEN=
# 32 random bytes, encoded as base64. Keep a secure backup; do not rotate blindly.
META_TOKEN_ENCRYPTION_KEY=
# Copy the extras object from the official Embedded Signup launch snippet for your configuration.
# JSON: feature/featureType/version strings, sessionInfoVersion string/integer, empty setup object.
META_EMBEDDED_SIGNUP_EXTRAS=
# Local-only administrator provisioning, never needed by the deployed app.
PROVISION_EMAIL=
PROVISION_PASSWORD=
PROVISION_TENANT_NAME=
PROVISION_TENANT_SLUG=
